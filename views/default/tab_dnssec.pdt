<?php /** @var View $this **/ ?>

<div id="ds-records">
    <h6 class="form-section-header first"><?php $this->_('Namesilo.tab_dnssec.title_disclaimer');?></h6>
    <div class="pad">
        <p class="text-warning"><?php $this->_('Namesilo.tab_dnssec.warning_message1'); ?></p>
        <p class="text-warning"><?php $this->_('Namesilo.tab_dnssec.warning_message2'); ?></p>
    </div>

    <h6 class="form-section-header"><?php $this->_('Namesilo.tab_dnssec.title_list');?></h6>
    <table class="table">
        <thead>
            <tr>
                <th><span><?php $this->_('Namesilo.dnssec.key_tag'); ?></span></th>
                <th><span><?php $this->_('Namesilo.dnssec.algorithm'); ?></span></th>
                <th><span><?php $this->_('Namesilo.dnssec.digest_type'); ?></span></th>
                <th><span><?php echo $this->_('Namesilo.dnssec.digest'); ?></span></th>
                <th><span><?php $this->_('Namesilo.tab_dnssec.field_delete'); ?></span></th>
            </tr>
        </thead>
        <?php
            if (!empty($vars->records) && count($vars->records) > 0 && $vars->records[0]) {
                foreach ($vars->records as $record) {
                    ?>
        <!-- List existing ds records -->
        <tbody>
            <tr>
                <td><?php echo (isset($record->key_tag) ? $record->key_tag : null); ?></td>
                <td><?php echo (isset($record->algorithm) ? $record->algorithm : null); ?></td>
                <td><?php echo (isset($record->digest_type) ? $record->digest_type : null); ?></td>
                <td><?php echo (isset($record->digest) ? $record->digest : null); ?></td>
                <td>
                    <?php

                            $this->Form->create($this->base_uri . 'clients/servicetab/' . (isset($client_id) ? $client_id : null) . '/' . (isset($service_id) ? $service_id : null) . '/tabDnssec/');

                            $this->Form->fieldHidden('digest', (isset($record->digest) ? $record->digest : null));
                            $this->Form->fieldHidden('key_tag', (isset($record->key_tag) ? $record->key_tag : null));
                            $this->Form->fieldHidden('algorithm', (isset($record->algorithm) ? $record->algorithm : null));
                            $this->Form->fieldHidden('digest_type', (isset($record->digest_type) ? $record->digest_type : null));

                            $button_attributes = [
                                'class' => 'btn',
                                'value' => 'deleteDnssec',
                                'type' => 'submit',
                            ];

                            $this->Form->fieldButton('action', $this->_('Namesilo.tab_dnssec.field_delete', true), $button_attributes);

                            $this->Form->end();
                            ?>
                </td>
            </tr>
        </tbody>
                    <?php
                }
            }
            ?>
    </table>

    <h6 class="form-section-header"><?php $this->_('Namesilo.tab_dnssec.title_add');?></h6>
                    <?php
        $this->Form->create($this->base_uri . 'clients/servicetab/' . (isset($client_id) ? $client_id : null) . '/' . (isset($service_id) ? $service_id : null) . '/tabDnssec/');
        ?>
    <table class="table">
        <!-- Add New DS Record -->
        <thead>
            <tr>
                <th><span><?php $this->_('Namesilo.dnssec.key_tag'); ?></span></th>
                <th><span><?php $this->_('Namesilo.dnssec.algorithm'); ?></span></th>
                <th><span><?php $this->_('Namesilo.dnssec.digest_type'); ?></span></th>
                <th><span><?php echo $this->_('Namesilo.dnssec.digest'); ?></span></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><?php $this->Form->fieldText('key_tag', '', ['class' => 'form-control']); ?></td>
                <td><?php $this->Form->fieldSelect('algorithm', $vars->selects['algorithm']['options'], '', ['class' => 'form-select']); ?></td>
                <td><?php $this->Form->fieldSelect('digest_type', $vars->selects['digest_type']['options'], '', ['class' => 'form-select']); ?></td>
                <td><?php $this->Form->fieldText('digest', '', ['class' => 'form-control']); ?></td>
            </tr>
        </tbody>
    </table>
    <div class="d-flex justify-content-end">
        <?php

            $button_attributes = [
                'class' => 'btn btn-primary',
                'value' => 'addDnssec',
                'type' => 'submit',
            ];

            $this->Form->fieldButton('action', $this->_('Namesilo.tab_dnssec.field_add', true), $button_attributes);
            ?>
    </div>
                    <?php
        $this->Form->end();
        ?>
</div>
