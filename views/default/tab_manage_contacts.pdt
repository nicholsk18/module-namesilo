<?php /** @var View $this **/ ?>

<?php $this->Form->create(
    $this->base_uri .
        'clients/servicetab/' .
        (isset($service->client_id) ? $this->Html->safe($service->client_id) : null) .
        '/' .
        (isset($service->id) ? $this->Html->safe($service->id) : null) .
        '/tabManageContacts/',
); ?>
<a class="btn btn-primary mb-2 float-end" href="<?php echo $this->base_uri .
    'clients/servicetab/' .
    (isset($service->client_id) ? $this->Html->safe($service->client_id) : null) .
    '/' .
    (isset($service->id) ? $this->Html->safe($service->id) : null) .
    '/tabManageContacts/?action=manage'; ?>"><i class="bi bi-plus-lg"></i> <?php $this->_(
    'Namesilo.tab_manage_contacts.option_add',
); ?></a>
<table class="table">
    <thead>
        <tr>
            <th class="icon">&nbsp;</th>
            <th><?php $this->_('Namesilo.tab_manage_contacts.heading_contact_id'); ?></th>
            <th><?php $this->_('Namesilo.tab_manage_contacts.heading_name'); ?></th>
            <th><?php $this->_('Namesilo.tab_manage_contacts.heading_options'); ?></th>
        </tr>
    </thead>
    <tbody>
        <?php
        $i = 0;
        foreach ($contacts ?? [] as $contact_id => $contact_name) { ?>
        <tr>
            <td><?php $this->Form->fieldRadio(
                'default_contact_id',
                $contact_id,
                ($vars->default_contact_id ?? null) == $contact_id,
                [],
            ); ?></td>
            <td><?php echo $this->Html->safe($contact_id); ?></td>
            <td><?php echo $this->Html->safe($contact_name); ?></td>
            <td>
                <a href="<?php echo $this->base_uri .
                    'clients/servicetab/' .
                    (isset($service->client_id) ? $this->Html->safe($service->client_id) : null) .
                    '/' .
                    (isset($service->id) ? $this->Html->safe($service->id) : null) .
                    '/tabManageContacts/?action=manage&contact_id=' .
                    $contact_id; ?>"><?php $this->_('Namesilo.tab_manage_contacts.option_edit'); ?></a>
                <a href="<?php echo $this->base_uri .
                    'clients/servicetab/' .
                    (isset($service->client_id) ? $this->Html->safe($service->client_id) : null) .
                    '/' .
                    (isset($service->id) ? $this->Html->safe($service->id) : null) .
                    '/tabManageContacts/?action=delete&contact_id=' .
                    $contact_id; ?>" class="manage"><?php $this->_('Namesilo.tab_manage_contacts.option_delete'); ?></a>
            </td>
        </tr>
                <?php $i++;}
        ?>
    </tbody>
</table>
<div class="d-flex justify-content-end gap-2">
    <?php
    $this->Form->fieldSubmit('pull_contacts', $this->_('Namesilo.tab_manage_contacts.field_sync', true), [
        'class' => 'btn btn-outline-secondary',
    ]);
    $this->Form->fieldSubmit('submit', $this->_('Namesilo.tab_manage_contacts.field_submit', true), [
        'class' => 'btn btn-primary',
    ]);
    ?>
</div>
                <?php $this->Form->end();
?>
