<?php /** @var View $this **/ ?>

<?php $this->Form->create(
    $this->base_uri .
        'clients/servicetab/' .
        (isset($service->client_id) ? $this->Html->safe($service->client_id) : null) .
        '/' .
        (isset($service->id) ? $this->Html->safe($service->id) : null) .
        '/tabManageContacts/',
); ?>
<div class="d-flex justify-content-end mb-2">
    <a class="btn btn-primary btn-sm" href="<?php echo $this->base_uri .
        'clients/servicetab/' .
        (isset($service->client_id) ? $this->Html->safe($service->client_id) : null) .
        '/' .
        (isset($service->id) ? $this->Html->safe($service->id) : null) .
        '/tabManageContacts/?action=manage'; ?>"><i class="bi bi-plus-lg me-1"></i><?php $this->_(
    'Namesilo.tab_manage_contacts.option_add',
); ?></a>
</div>
<table class="table w-100">
    <thead>
        <tr>
            <th>&nbsp;</th>
            <th><?php $this->_('Namesilo.tab_manage_contacts.heading_contact_id'); ?></th>
            <th><?php $this->_('Namesilo.tab_manage_contacts.heading_name'); ?></th>
            <th><?php $this->_('Namesilo.tab_manage_contacts.heading_actions'); ?></th>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($contacts ?? [] as $contact_id => $contact_name) { ?>
        <tr>
            <td><?php $this->Form->fieldRadio(
                'default_contact_id',
                $contact_id,
                ($vars->default_contact_id ?? null) == $contact_id,
                ['class' => 'form-check-input'],
            ); ?></td>
            <td><?php echo $this->Html->safe($contact_id); ?></td>
            <td><?php echo $this->Html->safe($contact_name); ?></td>
            <td>
                <a class="btn btn-sm btn-outline-secondary" href="<?php echo $this->base_uri .
                    'clients/servicetab/' .
                    (isset($service->client_id) ? $this->Html->safe($service->client_id) : null) .
                    '/' .
                    (isset($service->id) ? $this->Html->safe($service->id) : null) .
                    '/tabManageContacts/?action=manage&contact_id=' .
                    $contact_id; ?>" title="<?php $this->_('Namesilo.tab_manage_contacts.option_edit'); ?>">
                    <i class="bi bi-pencil"></i>
                </a>
                <a class="btn btn-sm btn-outline-danger" href="<?php echo $this->base_uri .
                    'clients/servicetab/' .
                    (isset($service->client_id) ? $this->Html->safe($service->client_id) : null) .
                    '/' .
                    (isset($service->id) ? $this->Html->safe($service->id) : null) .
                    '/tabManageContacts/?action=delete&contact_id=' .
                    $contact_id; ?>" title="<?php $this->_('Namesilo.tab_manage_contacts.option_delete'); ?>">
                    <i class="bi bi-trash"></i>
                </a>
            </td>
        </tr>
        <?php } ?>
    </tbody>
</table>
<div class="d-flex justify-content-end gap-2 mt-3">
    <?php
    $this->Form->fieldSubmit('pull_contacts', $this->_('Namesilo.tab_manage_contacts.field_sync', true), [
        'class' => 'btn btn-outline-secondary',
    ]);
    $this->Form->fieldSubmit('submit', $this->_('Namesilo.tab_manage_contacts.field_submit', true), [
        'class' => 'btn btn-primary',
    ]);
    ?>
</div>
<?php $this->Form->end(); ?>
